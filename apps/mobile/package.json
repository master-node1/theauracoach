{
  "name": "@aura/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "AuraCoach iOS and Android app (Expo). Signs in with Authorization Code + PKCE; tokens live only in the secure store.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@aura/api-client": "workspace:*",
    "@aura/i18n": "workspace:*",
    "@aura/ui-tokens": "workspace:*",
    "@formatjs/intl-pluralrules": "6.3.15",
    "expo": "~57.0.27",
    "expo-auth-session": "~57.0.14",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "use-intl": "4.14.9"
  },
  "devDependencies": {
    "@aura/dev-auth": "workspace:*",
    "@types/react": "~19.2.2",
    "vitest": "3.2.7"
  }
}
