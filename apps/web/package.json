{
  "name": "@aura/web",
  "version": "0.1.0",
  "private": true,
  "description": "AuraCoach web app and admin console (Next.js). Signs in through its own BFF; the browser never holds tokens.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test e2e",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@aura/api-client": "workspace:*",
    "@aura/contracts": "workspace:*",
    "@aura/ui-tokens": "workspace:*",
    "jose": "5.10.0",
    "next": "16.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@aura/dev-auth": "workspace:*",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.64.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.3",
    "vitest": "3.2.7"
  }
}
