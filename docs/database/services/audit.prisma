// audit-service — draft Prisma schema (Phase 3 design).
// Lives at services/audit-service/prisma/schema.prisma from Phase 4.
// Owns only its own database (audit_db). References to other services' data are
// plain id columns (no foreign keys); deletion arrives via the AccountDeleted event.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @db.Uuid // null for system
  actorRole  String?  @db.VarChar(40)
  action     String   @db.VarChar(60) // exercise.publish, policy.update, user.export, role.grant
  entityType String   @db.VarChar(40)
  entityId   String
  before     Json?
  after      Json?
  requestId  String?  @db.Uuid
  ipHash     String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  // append-only: UPDATE/DELETE revoked from the app role in migration SQL

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(60)
  version     Int       @default(1)
  userId      String?   @db.Uuid
  payload     Json
  traceparent String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([publishedAt, createdAt])
}

model ProcessedEvent {
  eventId     String   @id
  type        String   @db.VarChar(60)
  processedAt DateTime @default(now())
}
