// AuraCoach — draft Prisma schema (Phase 3 design).
// Moves to apps/api/prisma/schema.prisma in Phase 4. Hand-written SQL additions
// (pg_trgm indexes, partial indexes, CHECK constraints) are listed in ERD.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent, citext]
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  PENDING_DELETION
  DELETED
}

enum Sex {
  FEMALE
  MALE
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum GoalType {
  FAT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  GENERAL_FITNESS
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
  REPLACED
}

enum TrainingLocation {
  GYM
  HOME
  OUTDOOR
}

enum DietType {
  VEGETARIAN
  EGGETARIAN
  NON_VEGETARIAN
  VEGAN
  JAIN
  PESCATARIAN
}

enum IntensityCap {
  STANDARD
  LOW
}

enum ConsentPurpose {
  CORE_SERVICE
  AI_COACH
  NOTIFICATIONS
  MARKETING
  PROGRESS_PHOTOS
  HEALTH_INTEGRATIONS
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum MediaKind {
  VIDEO
  IMAGE
  ANIMATION
}

enum PlanStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum SessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  PARTIAL
  MISSED
  SKIPPED
}

enum WeekKind {
  NORMAL
  DELOAD
}

enum FoodSource {
  IFCT_2017
  USDA_FDC
  OPEN_FOOD_FACTS
  CURATED_RECIPE
  USER
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum FoodState {
  RAW
  COOKED
  AS_SOLD
}

enum MealSlot {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  EVENING_SNACK
  DINNER
  OTHER
}

enum MeasurementType {
  WEIGHT_KG
  WAIST_CM
  CHEST_CM
  HIPS_CM
  ARM_CM
  THIGH_CM
  NECK_CM
  BODY_FAT_PCT
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM_NOTICE
}

enum RecommendationKind {
  WORKOUT_SWAP
  WORKOUT_RESCHEDULE
  PLAN_ADJUSTMENT
  NUTRITION_TARGET_CHANGE
  MEAL_SWAP
  GENERAL_TIP
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  INVALIDATED
}

enum RecommendationSource {
  ENGINE
  COACH
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

enum NotificationStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
  SUPPRESSED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum IntegrationProvider {
  APPLE_HEALTH
  HEALTH_CONNECT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// ───────────────────────── Identity & users ─────────────────────────

model User {
  id            String     @id @default(uuid()) @db.Uuid
  cognitoSub    String     @unique
  email         String     @unique @db.Citext
  displayName   String?    @db.VarChar(60)
  status        UserStatus @default(ACTIVE)
  deletionDueAt DateTime?
  timezone      String     @default("Asia/Kolkata")
  locale        String     @default("en-IN")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastActiveAt  DateTime?

  profile          Profile?
  preference       UserPreference?
  roles            UserRole[]
  consents         Consent[]
  goals            FitnessGoal[]
  assessments      FitnessAssessment[]
  screenings       SafetyScreening[]
  conditions       HealthCondition[]
  equipment        UserEquipment[]
  measurements     BodyMeasurement[]
  checkIns         DailyCheckIn[]
  workoutPlans     WorkoutPlan[]
  workoutSessions  WorkoutSession[]
  nutritionTargets NutritionTarget[]
  mealPlans        MealPlan[]
  mealEntries      MealEntry[]
  waterEntries     WaterEntry[]
  dailySummaries   DailyNutritionSummary[]
  customFoods      FoodItem[]              @relation("FoodCreatedBy")
  conversations    CoachConversation[]
  recommendations  Recommendation[]
  coachMemories    CoachMemory[]
  feedback         UserFeedback[]
  personalRecords  PersonalRecord[]
  notifications    Notification[]
  devices          Device[]
  integrations     DeviceIntegration[]
  subscriptions    Subscription[]
  usageRecords     UsageRecord[]
  dataRequests     DataRequest[]

  @@index([status, deletionDueAt])
}

model Profile {
  userId          String           @id @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth     DateTime         @db.Date
  sex             Sex
  heightCm        Decimal          @db.Decimal(5, 1)
  activityLevel   ActivityLevel
  experience      ExperienceLevel
  unitSystem      UnitSystem       @default(METRIC)
  dietType        DietType
  cuisines        String[] // e.g. {"south_indian","punjabi"}
  allergens       String[] // controlled vocabulary: Allergen.code
  dislikedFoodIds String[]         @db.Uuid
  fastingDays     Int[] // 0=Sunday..6=Saturday
  trainingDays    Int[]
  sessionMinutes  Int              @default(45)
  location        TrainingLocation
  intensityCap    IntensityCap     @default(STANDARD)
  updatedAt       DateTime         @updatedAt
}

model UserPreference {
  userId           String   @id @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme            String   @default("system") // system | light | dark
  quietHoursStart  String   @default("22:00")
  quietHoursEnd    String   @default("07:00")
  workoutReminder  Boolean  @default(true)
  mealReminders    Boolean  @default(true)
  weeklySummary    Boolean  @default(true)
  inactivityNudges Int      @default(2) // max per week, 0 = off
  coachTone        String   @default("supportive")
  updatedAt        DateTime @updatedAt
}

model Role {
  id          String           @id @db.VarChar(40) // e.g. "content_editor"
  description String
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @db.VarChar(60) // e.g. "exercise:publish"
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.VarChar(40)
  permissionId String     @db.VarChar(60)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.VarChar(40)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy String?  @db.Uuid
  grantedAt DateTime @default(now())

  @@id([userId, roleId])
}

model Consent {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose       ConsentPurpose
  granted       Boolean
  policyVersion String         @db.VarChar(20)
  channel       String         @db.VarChar(20) // ios | android | web
  createdAt     DateTime       @default(now())

  @@index([userId, purpose, createdAt(sort: Desc)])
}

model DataRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String    @db.VarChar(10) // export | delete
  status      String    @db.VarChar(20) // queued | running | ready | failed | done
  artifactKey String? // S3 key of export, expires after 7 days
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, createdAt(sort: Desc)])
}

// ─────────────────────── Goals, screening, assessment ───────────────────────

model FitnessGoal {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           GoalType
  status         GoalStatus @default(ACTIVE)
  targetWeightKg Decimal?   @db.Decimal(5, 1)
  weeklyRatePct  Decimal?   @db.Decimal(4, 2) // % bodyweight per week, negative = loss
  targetDate     DateTime?  @db.Date
  createdAt      DateTime   @default(now())
  closedAt       DateTime?

  @@index([userId, status])
}

model SafetyScreening {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  version      String       @db.VarChar(20) // questionnaire version
  answers      Json // { questionCode: boolean }
  freeTextEnc  Bytes? // field-encrypted optional details
  flags        String[] // e.g. {"cardiac","pregnancy"}
  intensityCap IntensityCap
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model HealthCondition {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String    @db.VarChar(40) // controlled vocabulary: injury_knee, injury_lower_back, hypertension...
  severity   String    @db.VarChar(10) // mild | moderate | severe
  notesEnc   Bytes?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([userId, active])
}

model FitnessAssessment {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg      Decimal  @db.Decimal(5, 1)
  bmi           Decimal  @db.Decimal(4, 1)
  bmrKcal       Int
  tdeeKcal      Int
  engineVersion String   @db.VarChar(20)
  inputs        Json // snapshot of inputs used
  createdAt     DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model Equipment {
  code      String              @id @db.VarChar(40) // dumbbell, barbell, bench, pull_up_bar, resistance_band...
  name      String
  exercises ExerciseEquipment[]
  users     UserEquipment[]
}

model UserEquipment {
  userId        String    @db.Uuid
  equipmentCode String    @db.VarChar(40)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment     Equipment @relation(fields: [equipmentCode], references: [code])
  maxLoadKg     Decimal?  @db.Decimal(5, 1) // e.g. adjustable dumbbell max
  incrementKg   Decimal?  @db.Decimal(4, 2)

  @@id([userId, equipmentCode])
}

// ───────────────────────────── Workouts ─────────────────────────────

model MuscleGroup {
  code      String           @id @db.VarChar(30) // quadriceps, glutes, chest...
  name      String
  exercises ExerciseMuscle[]
}

model Exercise {
  id                String          @id @default(uuid()) @db.Uuid
  slug              String          @unique
  name              String
  status            ContentStatus   @default(DRAFT)
  version           Int             @default(1)
  movementPattern   String          @db.VarChar(30) // squat, hinge, push_h, push_v, pull_h, pull_v, lunge, carry, core, cardio
  mechanics         String          @db.VarChar(10) // compound | isolation
  difficulty        ExperienceLevel
  isBodyweight      Boolean         @default(false)
  instructions      String[]
  commonMistakes    String[]
  cues              String[]
  contraindications String[] // e.g. {"knee_high_load","spinal_flexion_loaded"}
  regressionId      String?         @db.Uuid
  progressionId     String?         @db.Uuid
  regression        Exercise?       @relation("Regression", fields: [regressionId], references: [id])
  progression       Exercise?       @relation("Progression", fields: [progressionId], references: [id])
  regressionOf      Exercise[]      @relation("Regression")
  progressionOf     Exercise[]      @relation("Progression")
  defaultRestSec    Int             @default(90)
  metValue          Decimal?        @db.Decimal(4, 1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  publishedAt       DateTime?

  muscles          ExerciseMuscle[]
  equipment        ExerciseEquipment[]
  media            ExerciseMedia[]
  templateItems    WorkoutTemplateExercise[]
  plannedExercises PlannedExercise[]
  sets             WorkoutSet[]
  personalRecords  PersonalRecord[]

  @@index([status, movementPattern])
}

model ExerciseMuscle {
  exerciseId String      @db.Uuid
  muscleCode String      @db.VarChar(30)
  role       String      @db.VarChar(10) // primary | secondary
  exercise   Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscle     MuscleGroup @relation(fields: [muscleCode], references: [code])

  @@id([exerciseId, muscleCode])
  @@index([muscleCode, role])
}

model ExerciseEquipment {
  exerciseId    String    @db.Uuid
  equipmentCode String    @db.VarChar(40)
  exercise      Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipment     Equipment @relation(fields: [equipmentCode], references: [code])

  @@id([exerciseId, equipmentCode])
}

model ExerciseMedia {
  id          String    @id @default(uuid()) @db.Uuid
  exerciseId  String    @db.Uuid
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  kind        MediaKind
  storageKey  String
  captionsKey String?
  altText     String
  durationSec Int?
  sortOrder   Int       @default(0)
}

model WorkoutTemplate {
  id          String                    @id @default(uuid()) @db.Uuid
  slug        String                    @unique
  name        String
  status      ContentStatus             @default(DRAFT)
  version     Int                       @default(1)
  goal        GoalType
  experience  ExperienceLevel
  daysPerWeek Int
  location    TrainingLocation
  split       String                    @db.VarChar(30) // full_body, upper_lower, ppl
  days        Json // [{dayIndex, name, focus}]
  items       WorkoutTemplateExercise[]
  plans       WorkoutPlan[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([status, goal, experience, daysPerWeek, location])
}

model WorkoutTemplateExercise {
  id         String          @id @default(uuid()) @db.Uuid
  templateId String          @db.Uuid
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dayIndex   Int
  order      Int
  exerciseId String          @db.Uuid
  exercise   Exercise        @relation(fields: [exerciseId], references: [id])
  sets       Int
  repMin     Int
  repMax     Int
  targetRpe  Decimal         @db.Decimal(3, 1)
  restSec    Int

  @@unique([templateId, dayIndex, order])
}

model WorkoutPlan {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId    String?           @db.Uuid
  template      WorkoutTemplate?  @relation(fields: [templateId], references: [id])
  goalId        String?           @db.Uuid
  status        PlanStatus        @default(ACTIVE)
  engineVersion String            @db.VarChar(20)
  startDate     DateTime          @db.Date
  weeks         WorkoutPlanWeek[]
  createdAt     DateTime          @default(now())
  // partial unique index (one ACTIVE plan per user) added in migration SQL

  @@index([userId, status])
}

model WorkoutPlanWeek {
  id        String           @id @default(uuid()) @db.Uuid
  planId    String           @db.Uuid
  plan      WorkoutPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekStart DateTime         @db.Date
  weekIndex Int
  kind      WeekKind         @default(NORMAL)
  rationale Json // engine explanation codes, shown to user and coach
  sessions  WorkoutSession[]

  @@unique([planId, weekStart])
}

model WorkoutSession {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @db.Uuid
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  planWeekId          String?           @db.Uuid
  planWeek            WorkoutPlanWeek?  @relation(fields: [planWeekId], references: [id], onDelete: SetNull)
  name                String
  scheduledDate       DateTime          @db.Date
  status              SessionStatus     @default(PLANNED)
  startedAt           DateTime?
  completedAt         DateTime?
  perceivedDifficulty Int? // 1-10 session RPE
  soreness            Int? // 1-5
  notes               String?           @db.VarChar(500)
  clientId            String?           @db.Uuid // offline idempotency key
  planned             PlannedExercise[]
  sets                WorkoutSet[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([userId, clientId])
  @@index([userId, scheduledDate])
  @@index([userId, status, scheduledDate])
}

model PlannedExercise {
  id                String         @id @default(uuid()) @db.Uuid
  sessionId         String         @db.Uuid
  session           WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order             Int
  exerciseId        String         @db.Uuid
  exercise          Exercise       @relation(fields: [exerciseId], references: [id])
  sets              Int
  repMin            Int
  repMax            Int
  targetLoadKg      Decimal?       @db.Decimal(6, 2)
  targetRpe         Decimal        @db.Decimal(3, 1)
  restSec           Int
  substitutedFromId String?        @db.Uuid
  progressionNote   String?

  @@unique([sessionId, order])
}

model WorkoutSet {
  id           String         @id @default(uuid()) @db.Uuid
  sessionId    String         @db.Uuid
  session      WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId   String         @db.Uuid
  exercise     Exercise       @relation(fields: [exerciseId], references: [id])
  setNumber    Int
  reps         Int?
  loadKg       Decimal?       @db.Decimal(6, 2)
  durationSec  Int?
  distanceM    Int?
  rpe          Decimal?       @db.Decimal(3, 1)
  isWarmup     Boolean        @default(false)
  painReported Boolean        @default(false)
  completedAt  DateTime       @default(now())
  clientId     String?        @db.Uuid

  @@unique([sessionId, exerciseId, setNumber])
  @@unique([sessionId, clientId])
  @@index([exerciseId, completedAt])
}

model PersonalRecord {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String   @db.Uuid
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  kind       String   @db.VarChar(20) // e1rm | max_load | max_reps | max_volume
  value      Decimal  @db.Decimal(8, 2)
  setId      String   @db.Uuid
  achievedAt DateTime

  @@index([userId, exerciseId, kind])
}

// ───────────────────────────── Nutrition ─────────────────────────────

model Nutrient {
  code    String         @id @db.VarChar(20) // energy_kcal, protein_g, carb_g, fat_g, fibre_g, iron_mg...
  name    String
  unit    String         @db.VarChar(10)
  isMacro Boolean        @default(false)
  values  FoodNutrient[]
}

model Allergen {
  code String @id @db.VarChar(30) // peanut, tree_nut, milk, egg, gluten, soy, fish, shellfish, sesame, mustard
  name String
}

model FoodItem {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  localNames      String[] // e.g. {"arhar dal","tuvar paruppu"}
  brand           String?
  barcode         String?            @unique
  source          FoodSource
  sourceRef       String? // IFCT code, FDC id, OFF code
  confidence      Confidence
  state           FoodState
  rawEquivalentId String?            @db.Uuid // cooked item → raw item for yield conversion
  rawEquivalent   FoodItem?          @relation("RawEquivalent", fields: [rawEquivalentId], references: [id])
  cookedForms     FoodItem[]         @relation("RawEquivalent")
  yieldFactor     Decimal?           @db.Decimal(4, 3) // cooked grams per raw gram
  densityGPerMl   Decimal?           @db.Decimal(5, 3)
  dietTags        String[] // vegetarian, vegan, jain, contains_egg, contains_meat, contains_fish
  allergens       String[] // Allergen.code
  cuisine         String?
  status          ContentStatus      @default(PUBLISHED)
  createdById     String?            @db.Uuid // set only for USER foods
  createdBy       User?              @relation("FoodCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  recipeId        String?            @unique @db.Uuid // composite dish computed from a recipe
  recipe          Recipe?            @relation("RecipeFood", fields: [recipeId], references: [id])
  nutrients       FoodNutrient[] // per 100 g (or 100 ml when densityGPerMl set)
  units           FoodUnit[]
  ingredientIn    RecipeIngredient[]
  mealEntries     MealEntry[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  // GIN trigram index on name and localNames added in migration SQL

  @@index([status, source])
  @@index([createdById])
}

model FoodNutrient {
  foodId       String   @db.Uuid
  nutrientCode String   @db.VarChar(20)
  food         FoodItem @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrient     Nutrient @relation(fields: [nutrientCode], references: [code])
  per100       Decimal  @db.Decimal(10, 3)

  @@id([foodId, nutrientCode])
}

model FoodUnit {
  id     String   @id @default(uuid()) @db.Uuid
  foodId String   @db.Uuid
  food   FoodItem @relation(fields: [foodId], references: [id], onDelete: Cascade)
  code   String   @db.VarChar(20) // katori, roti, piece, cup, tbsp, ladle, slice, serving
  label  String
  grams  Decimal  @db.Decimal(7, 2)

  @@unique([foodId, code])
}

model Recipe {
  id            String             @id @default(uuid()) @db.Uuid
  slug          String             @unique
  name          String
  status        ContentStatus      @default(DRAFT)
  version       Int                @default(1)
  cuisine       String?
  dietTags      String[]
  allergens     String[] // derived from ingredients on publish
  servings      Int
  cookedYieldG  Decimal            @db.Decimal(7, 1) // total cooked weight
  prepMinutes   Int
  cookMinutes   Int
  costTier      Int                @default(2) // 1 budget .. 3 premium
  steps         String[]
  substitutions Json // [{ingredientFoodId, alternatives:[foodId], note}]
  imageKey      String?
  ingredients   RecipeIngredient[]
  food          FoodItem?          @relation("RecipeFood")
  mealPlanItems MealPlanItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, cuisine])
}

model RecipeIngredient {
  id       String   @id @default(uuid()) @db.Uuid
  recipeId String   @db.Uuid
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodId   String   @db.Uuid
  food     FoodItem @relation(fields: [foodId], references: [id])
  grams    Decimal  @db.Decimal(7, 1) // always raw weight as purchased
  note     String?
  order    Int

  @@unique([recipeId, order])
}

model NutritionTarget {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime @db.Date
  energyKcal    Int
  proteinG      Int
  carbG         Int
  fatG          Int
  fibreG        Int
  waterMl       Int
  micros        Json // { iron_mg: 18, calcium_mg: 1000, ... }
  engineVersion String   @db.VarChar(20)
  rationale     Json // explanation codes and inputs
  createdAt     DateTime @default(now())

  @@unique([userId, effectiveFrom])
}

model MealPlan {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart     DateTime       @db.Date
  status        PlanStatus     @default(ACTIVE)
  engineVersion String         @db.VarChar(20)
  items         MealPlanItem[]
  createdAt     DateTime       @default(now())

  @@index([userId, weekStart])
}

model MealPlanItem {
  id         String   @id @default(uuid()) @db.Uuid
  mealPlanId String   @db.Uuid
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  slot       MealSlot
  recipeId   String   @db.Uuid
  recipe     Recipe   @relation(fields: [recipeId], references: [id])
  servings   Decimal  @db.Decimal(4, 2)

  @@unique([mealPlanId, date, slot, recipeId])
}

model MealEntry {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime   @db.Date // user-local date
  slot       MealSlot
  foodId     String?    @db.Uuid
  food       FoodItem?  @relation(fields: [foodId], references: [id])
  manualName String?    @db.VarChar(120)
  quantity   Decimal    @db.Decimal(8, 2) // in `unitCode`
  unitCode   String     @db.VarChar(20) // g, ml, katori, roti...
  grams      Decimal    @db.Decimal(8, 2) // normalised
  state      FoodState
  nutrients  Json // snapshot { energy_kcal, protein_g, ... } at log time
  confidence Confidence
  method     String     @db.VarChar(10) // search | barcode | manual | plan | photo
  clientId   String?    @db.Uuid
  loggedAt   DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  // CHECK (food_id IS NOT NULL OR manual_name IS NOT NULL) in migration SQL

  @@unique([userId, clientId])
  @@index([userId, date])
}

model WaterEntry {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  ml       Int
  clientId String?  @db.Uuid
  loggedAt DateTime @default(now())

  @@unique([userId, clientId])
  @@index([userId, date])
}

model DailyNutritionSummary {
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  totals     Json // { energy_kcal, protein_g, carb_g, fat_g, fibre_g, ... }
  waterMl    Int
  targetId   String?  @db.Uuid
  entryCount Int
  updatedAt  DateTime @updatedAt

  @@id([userId, date])
}

// ───────────────────────────── Progress ─────────────────────────────

model BodyMeasurement {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @db.Uuid
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       MeasurementType
  value      Decimal         @db.Decimal(6, 2)
  measuredAt DateTime
  source     String          @default("manual") @db.VarChar(20) // manual | apple_health | health_connect
  clientId   String?         @db.Uuid

  @@unique([userId, clientId])
  @@index([userId, type, measuredAt(sort: Desc)])
}

model DailyCheckIn {
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  sleepHours   Decimal? @db.Decimal(3, 1)
  sleepQuality Int? // 1-5
  energy       Int? // 1-5
  soreness     Int? // 1-5
  mood         Int? // 1-5
  steps        Int?
  updatedAt    DateTime @updatedAt

  @@id([userId, date])
}

// ─────────────────────────────── Coach ───────────────────────────────

model CoachConversation {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String?        @db.VarChar(80)
  summary       String? // rolling summary after 20 turns
  safetyFlag    Boolean        @default(false)
  messages      CoachMessage[]
  createdAt     DateTime       @default(now())
  lastMessageAt DateTime       @default(now())

  @@index([userId, lastMessageAt(sort: Desc)])
}

model CoachMessage {
  id              String            @id @default(uuid()) @db.Uuid
  conversationId  String            @db.Uuid
  conversation    CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            MessageRole
  content         String
  toolCalls       Json? // [{name, inputHash, ok, durationMs}] — no raw outputs
  safety          Json? // {pre: category, post: category, action}
  aiRequestId     String?           @db.Uuid
  promptVersion   String?           @db.VarChar(40)
  clientId        String?           @db.Uuid
  createdAt       DateTime          @default(now())
  recommendations Recommendation[]
  feedback        UserFeedback[]

  @@unique([conversationId, clientId])
  @@index([conversationId, createdAt])
}

model Recommendation {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @db.Uuid
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         RecommendationKind
  source       RecommendationSource
  status       RecommendationStatus @default(PENDING)
  title        String               @db.VarChar(120)
  explanation  String
  payload      Json // engine-validated change set
  basisVersion String // hash of the state the proposal was validated against
  messageId    String?              @db.Uuid
  message      CoachMessage?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  decidedAt    DateTime?
  createdAt    DateTime             @default(now())

  @@index([userId, status, createdAt(sort: Desc)])
}

model CoachMemory {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key             String   @db.VarChar(60) // e.g. "prefers_morning_training"
  value           String   @db.VarChar(280)
  approvedAt      DateTime @default(now()) // only user-approved memories are stored
  sourceMessageId String?  @db.Uuid

  @@unique([userId, key])
}

model UserFeedback {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId    String?       @db.Uuid
  message      CoachMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  targetType   String        @db.VarChar(30) // coach_message | plan | food | exercise | app
  targetId     String?       @db.Uuid
  rating       Int? // -1 | 1 for thumbs, 1-5 for others
  reason       String?       @db.VarChar(40)
  comment      String?       @db.VarChar(1000)
  reviewStatus String        @default("new") @db.VarChar(20)
  createdAt    DateTime      @default(now())

  @@index([reviewStatus, createdAt])
}

model SafetyReview {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  messageId      String    @db.Uuid
  category       String    @db.VarChar(40) // red_flag_symptom, eating_disorder_signal, unsafe_request, injection_attempt
  status         String    @default("open") @db.VarChar(20)
  reviewerId     String?   @db.Uuid
  resolution     String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([status, createdAt])
}

// ─────────────────────────── Notifications ───────────────────────────

model Device {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  pushToken  String         @unique
  appVersion String
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@index([userId])
}

model Notification {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String              @db.VarChar(40) // workout_reminder, meal_reminder, weekly_summary, inactivity, plan_ready
  channel      NotificationChannel
  status       NotificationStatus  @default(SCHEDULED)
  scheduledFor DateTime
  sentAt       DateTime?
  dedupeKey    String // e.g. "workout_reminder:2026-10-12"
  payload      Json
  readAt       DateTime?
  error        String?
  createdAt    DateTime            @default(now())

  @@unique([userId, dedupeKey, channel])
  @@index([status, scheduledFor])
  @@index([userId, createdAt(sort: Desc)])
}

model DeviceIntegration {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    IntegrationProvider
  scopes      String[]
  connectedAt DateTime            @default(now())
  lastSyncAt  DateTime?
  revokedAt   DateTime?

  @@unique([userId, provider])
}

// ─────────────────────── Billing, usage, AI config ───────────────────────

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @db.Uuid
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             String             @db.VarChar(30) // free | plus
  status           SubscriptionStatus
  provider         String             @db.VarChar(20) // app_store | play | razorpay | stripe
  externalRef      String
  currentPeriodEnd DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([provider, externalRef])
  @@index([userId, status])
}

model UsageRecord {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @db.Uuid
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature         String   @db.VarChar(40) // coach_chat, weekly_summary, safety_classifier, meal_photo
  provider        String   @db.VarChar(20)
  model           String   @db.VarChar(60)
  inputTokens     Int
  outputTokens    Int
  cacheReadTokens Int      @default(0)
  costMicroUsd    BigInt
  latencyMs       Int
  outcome         String   @db.VarChar(20) // ok | error | refusal | timeout | budget_blocked
  requestId       String   @db.Uuid
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model AiPromptVersion {
  id           String        @id @default(uuid()) @db.Uuid
  key          String        @db.VarChar(40) // coach_system, weekly_summary, safety_classifier
  version      Int
  status       ContentStatus @default(DRAFT)
  template     String
  outputSchema Json?
  evalScore    Json? // latest eval run results gating publish
  createdById  String        @db.Uuid
  createdAt    DateTime      @default(now())
  publishedAt  DateTime?

  @@unique([key, version])
}

model AiModelConfig {
  feature        String   @id @db.VarChar(40)
  provider       String   @db.VarChar(20)
  model          String   @db.VarChar(60)
  effort         String   @db.VarChar(10)
  maxTokens      Int
  timeoutMs      Int
  dailyUserQuota Int?
  enabled        Boolean  @default(true)
  updatedById    String   @db.Uuid
  updatedAt      DateTime @updatedAt
}

model CoachingPolicy {
  key         String   @id @db.VarChar(40) // calorie_floor_female, max_weekly_loss_pct, red_flag_terms...
  value       Json
  description String
  updatedById String   @db.Uuid
  updatedAt   DateTime @updatedAt
}

model FeatureFlag {
  key       String   @id @db.VarChar(40)
  enabled   Boolean  @default(false)
  rules     Json? // percentage, allow-list of user ids
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────── Audit ───────────────────────────────

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @db.Uuid // null for system
  actorRole  String?  @db.VarChar(40)
  action     String   @db.VarChar(60) // exercise.publish, policy.update, user.export, role.grant
  entityType String   @db.VarChar(40)
  entityId   String
  before     Json?
  after      Json?
  requestId  String?  @db.Uuid
  ipHash     String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  // append-only: UPDATE/DELETE revoked from the app role in migration SQL

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

// ────────────────────────────── Outbox ──────────────────────────────

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(60)
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, createdAt])
}
