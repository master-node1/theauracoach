{
  "$description": "Aura design tokens, the source for packages/ui-tokens (CSS variables on web, TS constants on React Native). Values match design-system.md and the approved high-fidelity designs (TAC-3).",
  "color": {
    "light": {
      "bg": "#FAFAF7",
      "surface": "#FFFFFF",
      "surface-2": "#F1F2EE",
      "text": "#16181D",
      "text-muted": "#5B606B",
      "primary": "#0E7C66",
      "on-primary": "#FFFFFF",
      "primary-soft": "#E2F1EC",
      "accent": "#E07A2E",
      "accent-text": "#A4521A",
      "accent-soft": "#FBEBDD",
      "protein": "#3D5AFE",
      "carbs": "#C77800",
      "fat": "#8E44AD",
      "fibre": "#2E7D32",
      "info": "#1565C0",
      "info-soft": "#E5EEF9",
      "warning": "#9A6700",
      "warning-soft": "#FBF1D9",
      "danger": "#B3261E",
      "border": "#DADCD6"
    },
    "dark": {
      "bg": "#0F1115",
      "surface": "#181B21",
      "surface-2": "#21252D",
      "text": "#ECEDEF",
      "text-muted": "#A3A8B3",
      "primary": "#38C6A5",
      "on-primary": "#06231D",
      "primary-soft": "#16302A",
      "accent": "#F29A57",
      "accent-text": "#F29A57",
      "accent-soft": "#3A2A1D",
      "protein": "#8C9EFF",
      "carbs": "#FFB74D",
      "fat": "#CE93D8",
      "fibre": "#81C784",
      "info": "#64B5F6",
      "info-soft": "#172434",
      "warning": "#F2C94C",
      "warning-soft": "#2E2814",
      "danger": "#F2B8B5",
      "border": "#2E333C"
    },
    "android": {
      "light": { "primary-container": "#A7EBD6", "on-primary-container": "#00201A", "nav-indicator": "#C3E9DD" },
      "dark": { "primary-container": "#0F5244", "on-primary-container": "#A7EBD6", "nav-indicator": "#1F4A40" }
    }
  },
  "font": {
    "family": { "sans": "Inter, 'Noto Sans Devanagari', system-ui, sans-serif" },
    "size": { "display": "2rem", "h1": "1.5rem", "h2": "1.25rem", "h3": "1.125rem", "body": "1rem", "small": "0.875rem", "caption": "0.75rem" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "heavy": 800 },
    "lineHeight": { "body": 1.4, "heading": 1.2 },
    "numeric": "tabular-nums"
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48, 64],
  "radius": { "input": 8, "button": 12, "card": 12, "card-lg": 16, "sheet": 22, "pill": 999 },
  "size": { "touch-target": 48, "tab-bar-height": 56, "mobile-frame": [390, 844], "android-frame": [360, 800] },
  "elevation": {
    "light": { "card": "0 1px 2px rgba(22,24,29,.06), 0 2px 8px rgba(22,24,29,.05)", "sheet": "0 -8px 24px rgba(22,24,29,.10)" },
    "dark": { "card": "none", "sheet": "none" }
  },
  "motion": { "micro": "150ms", "transition": "250ms", "easing": "ease-out" },
  "breakpoint": { "tablet": 768, "desktop": 1024, "content-max": 1200 }
}
