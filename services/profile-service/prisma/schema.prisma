// profile-service Prisma schema. This service owns only its own database (profile_db).
// References to other services' data are plain id columns (no foreign keys);
// deletion arrives via the AccountDeleted event. Design: docs/architecture/service-catalog.md

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum ConsentPurpose {
  CORE_SERVICE
  AI_COACH
  NOTIFICATIONS
  MARKETING
  PROGRESS_PHOTOS
  HEALTH_INTEGRATIONS
}

enum DietType {
  VEGETARIAN
  EGGETARIAN
  NON_VEGETARIAN
  VEGAN
  JAIN
  PESCATARIAN
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
  REPLACED
}

enum GoalType {
  FAT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  GENERAL_FITNESS
}

enum IntensityCap {
  STANDARD
  LOW
}

enum OnboardingState {
  NOT_STARTED
  IN_PROGRESS
  PLANNING
  READY
}

enum Sex {
  FEMALE
  MALE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum TrainingLocation {
  GYM
  HOME
  OUTDOOR
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum UserStatus {
  ACTIVE
  PENDING_DELETION
  DELETED
}

model User {
  /// Equal to the Cognito `sub`, so other services can key data by the token subject.
  id            String     @id @db.Uuid
  cognitoSub    String     @unique
  email         String     @unique @db.Citext
  displayName   String?    @db.VarChar(60)
  status        UserStatus @default(ACTIVE)
  deletionDueAt DateTime?
  timezone      String     @default("Asia/Kolkata")
  locale        String     @default("en-IN")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastActiveAt  DateTime?

  profile       Profile?
  preference    UserPreference?
  roles         UserRole[]
  consents      Consent[]
  goals         FitnessGoal[]
  assessments   FitnessAssessment[]
  screenings    SafetyScreening[]
  conditions    HealthCondition[]
  subscriptions Subscription[]
  dataRequests  DataRequest[]
  onboarding    Onboarding?

  @@index([status, deletionDueAt])
}

model Profile {
  userId          String           @id @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth     DateTime         @db.Date
  sex             Sex
  heightCm        Decimal          @db.Decimal(5, 1)
  activityLevel   ActivityLevel
  experience      ExperienceLevel
  unitSystem      UnitSystem       @default(METRIC)
  dietType        DietType
  cuisines        String[] // e.g. {"south_indian","punjabi"}
  allergens       String[] // controlled vocabulary: Allergen.code
  dislikedFoodIds String[]         @db.Uuid
  fastingDays     Int[] // 0=Sunday..6=Saturday
  trainingDays    Int[]
  sessionMinutes  Int              @default(45)
  location        TrainingLocation
  equipmentCodes  String[]
  intensityCap    IntensityCap     @default(STANDARD)
  updatedAt       DateTime         @updatedAt
}

model UserPreference {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme     String   @default("system") // system | light | dark
  coachTone String   @default("supportive")
  updatedAt DateTime @updatedAt
}

model Role {
  id          String     @id @db.VarChar(40) // a role from packages/contracts GRANTABLE_ROLES, e.g. "content_editor"; seeded by migration
  description String
  users       UserRole[]
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.VarChar(40)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy String?  @db.Uuid
  grantedAt DateTime @default(now())

  @@id([userId, roleId])
}

model Consent {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose       ConsentPurpose
  granted       Boolean
  policyVersion String         @db.VarChar(20)
  channel       String         @db.VarChar(20) // ios | android | web
  createdAt     DateTime       @default(now())

  @@index([userId, purpose, createdAt(sort: Desc)])
}

model DataRequest {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String            @db.VarChar(10) // export | delete
  status      String            @db.VarChar(20) // queued | running | ready | failed | done | expired | cancelled
  artifactKey String? // S3 key of export, expires after 7 days
  createdAt   DateTime          @default(now())
  completedAt DateTime?
  /// Export: when the file is removed. Deletion: when it becomes final (end of the grace period).
  dueAt       DateTime?
  /// Deletion: when the missing-acknowledgement alert was raised, so it is raised once.
  alertedAt   DateTime?
  parts       DataRequestPart[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([kind, status, dueAt])
}

/// One participant service's part of an export or deletion, tracked to completion (catalog §6.3).
model DataRequestPart {
  requestId String      @db.Uuid
  request   DataRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  service   String      @db.VarChar(40)
  /// Export: the part's object key. Deletion: null.
  key       String?
  rows      Int?
  doneAt    DateTime?

  @@id([requestId, service])
}

model FitnessGoal {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           GoalType
  status         GoalStatus @default(ACTIVE)
  targetWeightKg Decimal?   @db.Decimal(5, 1)
  weeklyRatePct  Decimal?   @db.Decimal(4, 2) // % bodyweight per week, negative = loss
  targetDate     DateTime?  @db.Date
  createdAt      DateTime   @default(now())
  closedAt       DateTime?

  @@index([userId, status])
}

model SafetyScreening {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  version      String       @db.VarChar(20) // questionnaire version
  answers      Json // { questionCode: boolean }
  freeTextEnc  Bytes? // field-encrypted optional details
  flags        String[] // e.g. {"cardiac","pregnancy"}
  intensityCap IntensityCap
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model HealthCondition {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String    @db.VarChar(40) // controlled vocabulary: injury_knee, injury_lower_back, hypertension...
  severity   String    @db.VarChar(10) // mild | moderate | severe
  notesEnc   Bytes?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([userId, active])
}

model FitnessAssessment {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg      Decimal  @db.Decimal(5, 1)
  bmi           Decimal  @db.Decimal(4, 1)
  bmrKcal       Int
  tdeeKcal      Int
  engineVersion String   @db.VarChar(20)
  inputs        Json // snapshot of inputs used
  createdAt     DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @db.Uuid
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             String             @db.VarChar(30) // free | plus
  status           SubscriptionStatus
  provider         String             @db.VarChar(20) // app_store | play | razorpay | stripe
  externalRef      String
  currentPeriodEnd DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([provider, externalRef])
  @@index([userId, status])
}

/// Saga state for POST /v1/onboarding/complete (service catalog §6.1)
model Onboarding {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @unique @db.Uuid
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           OnboardingState @default(NOT_STARTED)
  questionnaireVer String
  planId           String?         @db.Uuid
  targetId         String?         @db.Uuid
  completedAt      DateTime?
  readyAt          DateTime?
  updatedAt        DateTime        @updatedAt
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(60)
  version     Int       @default(1)
  userId      String?   @db.Uuid
  payload     Json
  traceparent String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([publishedAt, createdAt])
}

model ProcessedEvent {
  eventId     String   @id
  type        String   @db.VarChar(60)
  processedAt DateTime @default(now())
}
