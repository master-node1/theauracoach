# Local development values only. Real values come from AWS Secrets Manager via External Secrets.
SERVICE_NAME=profile-service
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://profile_svc:local-dev-only@localhost:5432/profile_db
REDIS_URL=redis://localhost:6379
AUTH_JWKS_URL=http://localhost:4100/.well-known/jwks.json
AUTH_ISSUER=http://localhost:4100
AUTH_CLIENT_IDS=aura-dev-client
INTERNAL_TOKEN_SECRET=local-dev-only-internal-secret-change-me
INTERNAL_SERVICE_URLS=
# Cognito user API: GlobalSignOut and role-group mirroring; dev-auth locally. Pool id is required in production.
IDENTITY_ENDPOINT=http://localhost:4100/
# COGNITO_USER_POOL_ID=ap-south-1_example
AWS_REGION=ap-south-1
# Set to export traces and metrics, e.g. to the observability profile: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Feature flags (platform LLD §11): env (FEATURE_<KEY> variables only), file (FLAGS_FILE, re-read
# every FLAGS_POLL_SECONDS) or appconfig (APPCONFIG_APPLICATION/ENVIRONMENT/PROFILE, deployed only).
FLAGS_SOURCE=file
FLAGS_FILE=../../infra/local/flags/flags.json
FLAGS_POLL_SECONDS=5
# API limits (security architecture §5); defaults 300/min per user, 1000/min per IP.
RATE_LIMIT_ENABLED=true
