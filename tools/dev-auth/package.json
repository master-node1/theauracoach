{
  "name": "@aura/dev-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Local stand-in for Cognito: JWKS, test tokens, the Authorization Code + PKCE sign-in flow and the email sign-up/reset API. Development and tests only.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aura-dev-auth": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@aura/contracts": "workspace:*",
    "jose": "5.10.0"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@aura/api-client": "workspace:*",
    "vitest": "3.2.7"
  }
}
