    {
      "slug": "barbell-deadlift",
      "name": "Barbell deadlift",
      "movementPattern": "hinge",
      "mechanics": "compound",
      "difficulty": "INTERMEDIATE",
      "tracking": "reps",
      "primaryMuscles": ["hamstrings", "glutes", "lower_back"],
      "secondaryMuscles": ["forearms", "traps", "upper_back"],
      "equipment": ["barbell"],
      "instructions": [
        "Stand with the bar over your mid-foot and feet hip-width apart.",
        "Hinge down and grip the bar just outside your legs.",
        "Flatten your back, pull your shoulders down and take the slack out of the bar.",
        "Push the floor away and stand up, keeping the bar close to your legs.",
        "Lower by pushing your hips back."
      ],
      "cues": ["Bar stays against the legs", "Chest up, back flat", "Push the floor away"],
