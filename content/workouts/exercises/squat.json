    {
      "slug": "barbell-back-squat",
      "name": "Barbell back squat",
      "movementPattern": "squat",
      "mechanics": "compound",
      "difficulty": "INTERMEDIATE",
      "tracking": "reps",
      "primaryMuscles": ["quadriceps", "glutes"],
      "secondaryMuscles": ["hamstrings", "core", "lower_back"],
      "equipment": ["barbell"],
      "instructions": [
        "Set the bar in a rack just below shoulder height and step under it so it rests on your upper back.",
        "Lift the bar off the hooks, take two steps back and stand with feet shoulder-width apart, toes slightly out.",
        "Brace your core, then bend your hips and knees together to sit down between your heels.",
        "Go as low as you can keep a neutral back, ideally thighs parallel to the floor.",
        "Drive through your whole foot to stand up, keeping your chest up."
      ],
      "cues": ["Knees track over your toes", "Keep your chest proud", "Push the floor away"],
      "commonMistakes": [
        "Letting the knees cave inwards",
        "Rounding the lower back at the bottom",
        "Rising onto the toes"
      ],
      "contraindications": [
        "knee_high_load",
        "axial_load_heavy",
        "deep_knee_flexion_loaded",
        "valsalva_heavy"
      ],
      "contraindicationsReviewed": true,
      "regression": "goblet-squat",
      "progression": "barbell-front-squat",
      "defaultRestSec": 150,
      "loadIncrementKg": 2.5,
      "metValue": 5.0,
