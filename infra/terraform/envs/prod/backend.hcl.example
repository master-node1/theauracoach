# Copy to backend.hcl (git-ignored) with the outputs of infra/terraform/bootstrap.
bucket         = "auracoach-prod-tfstate-<account-id>"
key            = "platform/prod.tfstate"
region         = "ap-south-1"
dynamodb_table = "auracoach-prod-tflock"
encrypt        = true
kms_key_id     = "arn:aws:kms:ap-south-1:<account-id>:key/<key-id>"
