{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["cluster", "namespaces", "environments", "region"],
  "properties": {
    "cluster": { "type": "string", "enum": ["nonprod", "prod"] },
    "region": { "type": "string" },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "enum": ["dev", "staging", "prod"] },
      "additionalProperties": {
        "type": "object",
        "required": ["namespacePrefix", "inClusterData", "secretsRoleArn", "hosts"],
        "additionalProperties": false,
        "properties": {
          "namespacePrefix": { "type": "string", "pattern": "^$|^[a-z]+-$" },
          "inClusterData": { "type": "boolean" },
          "secretsRoleArn": { "type": "string", "pattern": "^arn:aws:iam::[0-9]{12}:role/.+$" },
          "hosts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
          }
        }
      }
    }
  }
}
