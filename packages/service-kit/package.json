{
  "name": "@aura/service-kit",
  "version": "0.1.0",
  "private": true,
  "description": "What every AuraCoach service shares: config, logging, errors, health, auth guards, internal client, outbox and event consumer",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --exclude 'test/**/*.int.test.ts'",
    "test:int": "vitest run test/*.int.test.ts"
  },
  "dependencies": {
    "@aura/contracts": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "5.10.0",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@aura/dev-auth": "workspace:*",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pg": "8.23.1",
    "supertest": "7.3.1",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
